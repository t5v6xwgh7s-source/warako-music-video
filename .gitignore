# Large media / generated files
assets/audio/*
assets/video/*
output/*
work/temp/*
work/generated/*

# Keep directories
!assets/audio/.gitkeep
!assets/video/.gitkeep
!output/preview/.gitkeep
!output/final/.gitkeep
!work/temp/.gitkeep
!work/generated/.gitkeep
!work/generated/video_requests.md
!work/generated/image_requests.md

# Python cache
__pycache__/

# Source artwork extracted from the picture-book HTML (preview material; keep local, not in Git)
assets/images/*
!assets/images/.gitkeep

# Secrets (YouTube / Google OAuth etc.) - never commit
.env
.env.*
*.env
client_secret*.json
credentials*.json
*refresh_token*
*.token
.youtube/
secrets/
